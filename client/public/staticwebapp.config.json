{
  "routes": [
    { "route": "/app", "rewrite": "/index.csr.html" },
    { "route": "/app/*", "rewrite": "/index.csr.html" },
    { "route": "/admin", "rewrite": "/index.csr.html" },
    { "route": "/admin/*", "rewrite": "/index.csr.html" },
    { "route": "/forbidden", "rewrite": "/index.csr.html" },
    { "route": "/*.js", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "route": "/*.css", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "route": "/media/*", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "route": "/fonts/*", "headers": { "cache-control": "public, max-age=2592000" } },
    { "route": "/images/*", "headers": { "cache-control": "public, max-age=604800" } },
    { "route": "/icons/*", "headers": { "cache-control": "public, max-age=604800" } }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404/index.html",
      "statusCode": 404
    }
  }
}
